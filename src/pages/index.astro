---
import { getCollection } from 'astro:content';
import { sections } from '../data/posts';
const sortedPosts = (await getCollection('posts')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const formatDate = (date: Date) => new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Shanghai' }).format(date);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="画画、日常、科研与代码学习的个人记录。" />
    <title>我的小小记录</title>
    <link rel="preconnect" href="https://images.unsplash.com" />
    <style>
      :root{font-family:ui-sans-serif,system-ui,-apple-system,"PingFang SC","Microsoft YaHei",sans-serif;color:#292d2b;background:#f7f6f2}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0}a{color:inherit;text-decoration:none}.site-header{height:72px;display:flex;align-items:center;justify-content:space-between;max-width:1160px;margin:auto;padding:0 24px}.brand{font-size:20px;font-weight:750;letter-spacing:.08em}.brand span{color:#d78d76}.top-nav{display:flex;gap:26px;font-size:14px;color:#626964}.top-nav a:hover{color:#d78d76}.intro{max-width:1160px;margin:0 auto;padding:72px 24px 82px}.eyebrow{font-size:13px;letter-spacing:.22em;color:#b27866;font-weight:700}.intro h1{font-size:clamp(36px,6vw,68px);line-height:1.17;letter-spacing:-.04em;margin:18px 0}.intro p{font-size:17px;color:#747b75;line-height:1.8;margin:0}.section-grid{max-width:1160px;margin:0 auto 96px;padding:0 24px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:26px}.section{min-width:0}.cover{height:260px;background-size:cover;background-position:center;position:relative;border-radius:18px 18px 0 0;overflow:hidden;display:flex;align-items:flex-end;padding:26px;color:white}.cover:before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 30%,rgba(18,24,25,.68))}.cover-content{position:relative}.cover .icon{font-size:22px}.cover h2{font-size:30px;margin:5px 0}.cover p{margin:0;font-size:13px;opacity:.92}.feed{background:white;border:1px solid #eeeae3;border-top:0;border-radius:0 0 18px 18px;min-height:230px;padding:0 24px}.post{padding:25px 0;border-bottom:1px solid #eeeee9}.post:last-child{border-bottom:0}.post-head{display:flex;align-items:center;gap:10px;color:#8c938d;font-size:12px}.avatar{width:31px;height:31px;border-radius:50%;display:grid;place-items:center;color:white;font-size:15px;font-weight:700}.author{font-size:13px;font-weight:700;color:#3a413c}.post-text{white-space:pre-line;font-size:15px;line-height:1.85;margin:15px 0;color:#414843}.post-images{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:16px 0}.post-images img{display:block;width:100%;aspect-ratio:1.45;object-fit:cover;border-radius:8px}.tags{display:flex;gap:7px;flex-wrap:wrap}.tag{font-size:11px;padding:5px 9px;border-radius:99px;background:#f5f4f0;color:#8b908b}.empty{padding:24px 0;color:#9aa09a;font-size:13px}.footer{text-align:center;color:#9aa09a;font-size:12px;padding:12px 24px 50px}@media(max-width:680px){.site-header{height:62px}.top-nav{gap:12px;font-size:12px}.brand{font-size:17px}.intro{padding:55px 24px 60px}.intro p{font-size:15px}.section-grid{grid-template-columns:1fr;gap:22px;margin-bottom:56px}.cover{height:230px}.feed{padding:0 20px}}
    </style>
  </head>
  <body>
    <header class="site-header"><a class="brand" href="#top">我的小小<span>记录</span></a><nav class="top-nav" aria-label="分区导航">{sections.map(section => <a href={`#${section.id}`}>{section.name}</a>)}</nav></header>
    <main id="top">
      <div class="intro"><div class="eyebrow">A LITTLE SPACE OF MINE</div><h1>你好，欢迎来到<br />我的小小世界。</h1><p>画画、日常、科研、代码学习。<br />把走过的路和遇见的风景，慢慢记在这里。</p></div>
      <div class="section-grid">{sections.map(section => {
        const sectionPosts = sortedPosts.filter(post => post.data.section === section.id);
        return <section class="section" id={section.id} aria-labelledby={`${section.id}-title`}>
          <div class="cover" style={`background-image:url('${section.cover}')`}><div class="cover-content"><span class="icon">{section.icon}</span><h2 id={`${section.id}-title`}>{section.name}</h2><p>{section.subtitle}</p></div></div>
          <div class="feed">{sectionPosts.length ? sectionPosts.map(post => <article class="post"><div class="post-head"><span class="avatar" style={`background:${section.color}`}>{section.name[0]}</span><span class="author">我的记录</span><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></div><p class="post-text">{post.data.text}</p>{post.data.images.length > 0 && <div class="post-images">{post.data.images.map((src, i) => <img src={src} alt={`${section.name}帖子图片 ${i + 1}`} loading="lazy" />)}</div>}{post.data.tags.length > 0 && <div class="tags">{post.data.tags.map(tag => <span class="tag"># {tag}</span>)}</div>}</article>) : <p class="empty">这里还没有帖子，等一条新的记录。</p>}</div>
        </section>;
      })}</div>
    </main><footer class="footer">© {new Date().getFullYear()} 我的记录 · 用 Astro 制作</footer>
  </body>
</html>
